# Copy this file to .env.local and fill in the values.
# .env.local is ignored by Git, so never put real secrets in this file.

# Base URL of the app (used later for auth redirects)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase: Project Settings -> API Keys in the Supabase dashboard.
# Both values are safe to expose in the browser; Row Level Security protects the data.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key

# Never add the secret / service role key with a NEXT_PUBLIC_ prefix.
# Only add it here (without NEXT_PUBLIC_) if a server-only feature truly needs it.

# Optional, server only: a GitHub personal access token (no scopes needed, it only
# reads public data). Raises the landing page's GitHub preview (#34) from 60 to
# 5,000 GitHub API requests per hour. Leave empty to use the 60/hour limit.
GITHUB_TOKEN=
